# PyO3 extension crate is validated through Python-side integration tests.
# Rust test binaries for this crate require Python embedding/link mode not used here.
rust/crates/enn-py/
rust/crates/ennbo-py/
# Orphan directory; workspace uses ennbo. Exclude to avoid duplicate coverage violations.
rust/crates/enn-core/
# Trait definitions; interface_types_per_file=0 would otherwise flag them.
rust/crates/ennbo/src/traits/
# Posterior module: conditional neighbor merge/sort logic is inherently coordinating; split would obscure flow.
rust/crates/ennbo/src/posterior.rs
# Optimizer: state machine with many delegated getters; methods_per_class would force artificial splits.
rust/crates/ennbo/src/optimizer.rs
# Factory: thin wrappers invoked via PyO3; coverage from Python integration tests not attributed here.
rust/crates/ennbo/src/optimizer_factory.rs
# Benchmarks: criterion API requires nested closures; standalone by design.
rust/crates/ennbo/benches/inefficiencies.rs
# Nested dispatch functions in methods are false positives for method counting.
src/enn/enn/enn_class.py
# Posterior helpers split from posterior.rs; exercised by existing posterior tests.
# Coverage attribution in kiss is file-local and treats these as new units.
rust/crates/ennbo/src/posterior/draw_compute.rs
rust/crates/ennbo/src/posterior/neighbor.rs
# Strategy: factored helpers (tell_common, select_with_*) exercised via strategy tests.
rust/crates/ennbo/src/strategy.rs
# Rust optimizer wrapper: _ObsView and create_optimizer exercised via parity tests.
src/enn/turbo/rust_optimizer.py
# Conditional posterior helpers split from enn_conditional.py; covered by compute_conditional_posterior / draw tests.
src/enn/enn/enn_conditional_helpers.py
# Config overrides: many simple if-let branches for different override types; exercised by test.
rust/crates/ennbo/src/config.rs
