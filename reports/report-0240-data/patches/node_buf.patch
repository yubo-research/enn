diff --git a/rust/crates/bpann/src/index/tree_buf.rs b/rust/crates/bpann/src/index/tree_buf.rs
new file mode 100644
index 0000000..85f096a
--- /dev/null
+++ b/rust/crates/bpann/src/index/tree_buf.rs
@@ -0,0 +1,248 @@
+use std::cell::Cell;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use crate::error::BpannError;
+use crate::index::tree::{Tree, TREE_LEAF_CAPACITY};
+use crate::index::tree_counts::dist;
+use crate::index::tree_resid::RowSrc;
+use crate::index::tree_store::{Kind, TreeStore, META_WORDS, NO_PARENT};
+
+pub(super) const BUF_WORD: usize = META_WORDS - 32 - 2;
+pub(super) const BUF_BIT: u32 = 1 << 31;
+
+static SPLITS: AtomicU64 = AtomicU64::new(0);
+
+thread_local! {
+    static OVERRIDE: Cell<Option<usize>> = const { Cell::new(None) };
+    static LEAF_OVERRIDE: Cell<Option<bool>> = const { Cell::new(None) };
+}
+
+pub fn node_buf() -> usize {
+    static ENV: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    let env = *ENV.get_or_init(|| {
+        std::env::var("ENN_NODE_BUF")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(0)
+    });
+    OVERRIDE
+        .with(Cell::get)
+        .unwrap_or(env)
+        .min(TREE_LEAF_CAPACITY)
+}
+
+pub fn leaf_parents_only() -> bool {
+    static ENV: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    LEAF_OVERRIDE.with(Cell::get).unwrap_or_else(|| {
+        *ENV.get_or_init(|| std::env::var("ENN_NODE_BUF_LEAF").is_ok_and(|v| v == "1"))
+    })
+}
+
+pub fn set_leaf_parents_only(on: Option<bool>) {
+    LEAF_OVERRIDE.with(|c| c.set(on));
+}
+
+pub fn set_node_buf(rows: Option<usize>) {
+    OVERRIDE.with(|c| c.set(rows));
+}
+
+pub(super) fn note_split() {
+    SPLITS.fetch_add(1, Ordering::Relaxed);
+}
+
+fn splits() -> u64 {
+    SPLITS.load(Ordering::Relaxed)
+}
+
+impl TreeStore {
+    pub fn buffer_of(&self, id: u32) -> Option<u32> {
+        if self.is_leaf(id) {
+            return None;
+        }
+        let w = self.meta_words(id)[BUF_WORD];
+        (w != 0).then(|| w - 1)
+    }
+
+    pub fn is_buffer(&self, id: u32) -> bool {
+        let p = self.meta_words(id)[3];
+        p != NO_PARENT && p & BUF_BIT != 0
+    }
+
+    pub fn buffered_rows(&self, id: u32) -> usize {
+        self.buffer_of(id).map_or(0, |b| self.len(b))
+    }
+
+    pub(super) fn clear_buffer_link(&mut self, id: u32) {
+        self.meta_words_mut(id)[BUF_WORD] = 0;
+    }
+
+    fn ensure_buffer(&mut self, owner: u32) -> Result<u32, BpannError> {
+        if let Some(b) = self.buffer_of(owner) {
+            return Ok(b);
+        }
+        let b = self.alloc_near(Kind::Leaf, &[owner])?;
+        self.set_codes_valid(b, true);
+        self.set_ids_only(b, &[]);
+        self.meta_words_mut(b)[3] = owner | BUF_BIT;
+        self.set_count(b, 0);
+        self.set_radius(b, 0.0);
+        self.meta_words_mut(owner)[BUF_WORD] = b + 1;
+        Ok(b)
+    }
+
+    fn buf_push(&mut self, b: u32, row: u32, v: &[f32]) {
+        let (n, d) = (self.len(b), self.num_dim);
+        let words = self.slot_words_mut(b);
+        for (w, &x) in words[n * d..(n + 1) * d].iter_mut().zip(v) {
+            *w = x.to_bits();
+        }
+        self.push_entry(b, row, v);
+        self.set_count(b, n + 1);
+    }
+
+    pub fn buf_rows(&self, b: u32) -> (Vec<u32>, Vec<f32>) {
+        let (n, d) = (self.len(b), self.num_dim);
+        let rows = self.slot_words(b)[..n * d]
+            .iter()
+            .map(|&w| f32::from_bits(w))
+            .collect();
+        (self.ids(b).to_vec(), rows)
+    }
+
+    fn buf_take(&mut self, b: u32) -> (Vec<u32>, Vec<f32>) {
+        let out = self.buf_rows(b);
+        self.set_ids_only(b, &[]);
+        self.set_count(b, 0);
+        out
+    }
+
+    pub fn buf_cover(&self, owner: u32, c: &[f32]) -> f32 {
+        let Some(b) = self.buffer_of(owner).filter(|&b| self.len(b) > 0) else {
+            return 0.0;
+        };
+        let (_, rows) = self.buf_rows(b);
+        rows.chunks_exact(self.num_dim)
+            .map(|v| dist(v, c))
+            .fold(0.0, f32::max)
+    }
+}
+
+impl Tree {
+    pub(super) fn node_enter(
+        &mut self,
+        node: u32,
+        row: u32,
+        v: &[f32],
+        src: RowSrc,
+    ) -> Result<(), BpannError> {
+        let mut cur = node;
+        loop {
+            if self.store.is_leaf(cur) {
+                return self.leaf_enter(cur, row, v, src);
+            }
+            if self.buffers_at(cur) {
+                return self.buffer_enter(cur, row, v, src);
+            }
+            self.count_entry(cur, row);
+            cur = self.route_step(cur, row, v).0;
+        }
+    }
+
+    fn buffers_at(&self, node: u32) -> bool {
+        let s = &self.store;
+        !leaf_parents_only() || s.ids(node).first().is_some_and(|&c| s.is_leaf(c))
+    }
+
+    pub(super) fn buffer_enter(
+        &mut self,
+        node: u32,
+        row: u32,
+        v: &[f32],
+        src: RowSrc,
+    ) -> Result<(), BpannError> {
+        self.count_entry(node, row);
+        let b = self.store.ensure_buffer(node)?;
+        self.store.buf_push(b, row, v);
+        if self.store.len(b) >= node_buf().max(1) {
+            self.flush_node(node, src)?;
+        }
+        Ok(())
+    }
+
+    pub fn flush_node(&mut self, node: u32, src: RowSrc) -> Result<(), BpannError> {
+        let Some(b) = self.store.buffer_of(node) else {
+            return Ok(());
+        };
+        if self.store.len(b) == 0 {
+            return Ok(());
+        }
+        let (ids, rows) = self.store.buf_take(b);
+        let d = self.store.num_dim();
+        let start = splits();
+        for (i, &row) in ids.iter().enumerate() {
+            let v = &rows[i * d..(i + 1) * d];
+            if splits() != start {
+                self.cover_up(node, v);
+            }
+            let (child, _) = self.route_step(node, row, v);
+            self.node_enter(child, row, v, src)?;
+        }
+        Ok(())
+    }
+
+    fn leaf_enter(&mut self, leaf: u32, row: u32, v: &[f32], src: RowSrc) -> Result<(), BpannError> {
+        let s = &mut self.store;
+        s.set_count(leaf, s.count(leaf) + 1);
+        s.push_entry(leaf, row, v);
+        if s.len(leaf) > TREE_LEAF_CAPACITY {
+            let mut path = self.path_to(leaf);
+            self.split_leaf(leaf, &mut path, src)?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn path_to(&self, page: u32) -> Vec<(u32, usize)> {
+        let s = &self.store;
+        let mut path = Vec::new();
+        let mut cur = page;
+        while let Some(p) = s.parent(cur) {
+            let slot = s.ids(p).iter().position(|&c| c == cur);
+            path.push((p, slot.expect("parent lists its child")));
+            cur = p;
+        }
+        path.reverse();
+        path
+    }
+
+    fn cover_up(&mut self, node: u32, v: &[f32]) {
+        let mut cur = node;
+        while let Some(p) = self.store.parent(cur) {
+            let slot = self.store.ids(p).iter().position(|&c| c == cur);
+            let Some(slot) = slot else { return };
+            let d = self.store.num_dim();
+            let r = dist(v, &self.store.block(p)[slot * d..(slot + 1) * d]);
+            if r > self.store.radius(cur) {
+                self.store.set_radius(cur, r);
+            }
+            cur = p;
+        }
+    }
+
+    pub fn flush_all(&mut self) -> Result<(), BpannError> {
+        loop {
+            let owners: Vec<u32> = (0..self.num_pages() as u32)
+                .filter(|&p| !self.store.is_free(p) && self.store.buffered_rows(p) > 0)
+                .collect();
+            if owners.is_empty() {
+                return Ok(());
+            }
+            for p in owners {
+                self.flush_node(p, None)?;
+            }
+        }
+    }
+}
