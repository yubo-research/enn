@@ -0,0 +1,115 @@
+use super::*;
+use crate::index::tree_search::{search_tree_scored, F32_WALKS};
+use rand::{Rng, SeedableRng};
+
+fn build(n: usize, dim: usize, buf: usize, seed: u64) -> (Tree, Vec<f32>, tempfile::TempDir) {
+    set_node_buf(Some(buf));
+    let mut rng = rand_chacha::ChaCha8Rng::seed_from_u64(seed);
+    let vs: Vec<f32> = (0..n * dim).map(|_| rng.gen::<f32>()).collect();
+    let dir = tempfile::TempDir::new().unwrap();
+    let mut tree = Tree::new_tree(0, &vs[..dim], dim, dir.path().join("i")).unwrap();
+    for r in 1..n {
+        tree.insert_row(r as u32, &vs[r * dim..(r + 1) * dim]).unwrap();
+    }
+    (tree, vs, dir)
+}
+
+/// Every row (in a leaf or a buffer) lies within its ancestors' radii.
+fn assert_covered(tree: &Tree, vs: &[f32], dim: usize) {
+    let s = &tree.store;
+    let rows_under = |page: u32| -> Vec<u32> {
+        let mut out = Vec::new();
+        let mut stack = vec![page];
+        while let Some(p) = stack.pop() {
+            if s.is_leaf(p) {
+                out.extend_from_slice(s.ids(p));
+                continue;
+            }
+            if let Some(b) = s.buffer_of(p) {
+                out.extend_from_slice(s.ids(b));
+            }
+            stack.extend_from_slice(s.ids(p));
+        }
+        out
+    };
+    for p in (0..tree.num_pages() as u32).filter(|&p| !s.is_free(p) && !s.is_leaf(p)) {
+        for (c, &child) in s.block(p).chunks_exact(dim).zip(s.ids(p)) {
+            for row in rows_under(child) {
+                let x = &vs[row as usize * dim..(row as usize + 1) * dim];
+                assert!(dist(x, c) <= s.radius(child) * 1.0001 + 1e-6, "row {row}");
+            }
+        }
+    }
+}
+
+#[test]
+fn buffered_tree_holds_every_row_once_and_covers_it() {
+    let (n, dim) = (20_000, 3);
+    let (mut tree, vs, _dir) = build(n, dim, 30, 1);
+    let buffered: usize = (0..tree.num_pages() as u32)
+        .map(|p| tree.store.buffered_rows(p))
+        .sum();
+    assert!(buffered > 0, "some rows wait in buffers");
+    assert_eq!(tree.leaf_row_ids(), (0..n as u32).collect::<Vec<_>>());
+    assert_eq!(tree.header.indexed_rows, n);
+    tree.assert_counts_consistent();
+    assert_covered(&tree, &vs, dim);
+    tree.flush_all().unwrap();
+    assert_eq!(tree.leaf_row_ids(), (0..n as u32).collect::<Vec<_>>());
+    assert_covered(&tree, &vs, dim);
+    set_node_buf(None);
+}
+
+#[test]
+fn buffered_search_is_exact_without_a_budget() {
+    let (n, dim, k) = (5_000, 4, 10);
+    let (tree, vs, _dir) = build(n, dim, 64, 2);
+    let mut rng = rand_chacha::ChaCha8Rng::seed_from_u64(9);
+    for _ in 0..20 {
+        let q: Vec<f32> = (0..dim).map(|_| rng.gen::<f32>()).collect();
+        let d2 = |r: u32| -> f64 {
+            let x = &vs[r as usize * dim..(r as usize + 1) * dim];
+            x.iter()
+                .zip(&q)
+                .map(|(a, b)| f64::from(a - b).powi(2))
+                .sum()
+        };
+        let got = search_tree_scored(&tree, &q, k, usize::MAX, &F32_WALKS, None, |r, _, _| {
+            Ok(Some(d2(r)))
+        })
+        .unwrap();
+        let mut all: Vec<(u32, f64)> = (0..n as u32).map(|r| (r, d2(r))).collect();
+        all.sort_by(|a, b| a.1.total_cmp(&b.1));
+        let want: Vec<u32> = all[..k].iter().map(|p| p.0).collect();
+        let got: Vec<u32> = got.iter().map(|p| p.0).collect();
+        assert_eq!(got, want);
+    }
+    set_node_buf(None);
+}
+
+#[test]
+fn buffers_off_by_default_and_capped_at_a_leaf() {
+    set_node_buf(None);
+    if std::env::var_os("ENN_NODE_BUF").is_none() {
+        assert_eq!(node_buf(), 0);
+    }
+    set_node_buf(Some(1000));
+    assert_eq!(node_buf(), TREE_LEAF_CAPACITY);
+    set_node_buf(None);
+}
+
+#[test]
+fn leaf_parent_buffers_hold_every_row_once_and_cover_it() {
+    set_leaf_parents_only(Some(true));
+    let (n, dim) = (20_000, 3);
+    let (tree, vs, _dir) = build(n, dim, 64, 4);
+    let s = &tree.store;
+    for p in (0..tree.num_pages() as u32).filter(|&p| s.buffered_rows(p) > 0) {
+        assert!(s.is_leaf(s.ids(p)[0]), "only leaf parents buffer");
+    }
+    assert_eq!(tree.leaf_row_ids(), (0..n as u32).collect::<Vec<_>>());
+    tree.assert_counts_consistent();
+    assert_covered(&tree, &vs, dim);
+    set_leaf_parents_only(None);
+    set_node_buf(None);
+}
