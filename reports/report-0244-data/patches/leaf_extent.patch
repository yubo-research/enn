@@ -0,0 +1,122 @@
+use std::sync::atomic::{AtomicU64, AtomicU8, Ordering};
+use std::sync::OnceLock;
+
+use crate::error::BpannError;
+use crate::index::tree_sib::SIB_BLOCK;
+use crate::index::tree_store::{TreeStore, META_WORDS};
+
+static FLAG: AtomicU8 = AtomicU8::new(u8::MAX);
+static MOVED: AtomicU64 = AtomicU64::new(0);
+
+pub fn leaf_extents() -> bool {
+    static ENV: OnceLock<bool> = OnceLock::new();
+    match FLAG.load(Ordering::Relaxed) {
+        u8::MAX => *ENV.get_or_init(|| std::env::var("ENN_LEAF_EXTENT").as_deref() == Ok("1")),
+        v => v == 1,
+    }
+}
+
+pub fn set_leaf_extents(on: bool) {
+    FLAG.store(u8::from(on), Ordering::Relaxed);
+}
+
+pub fn take_extent_moves() -> u64 {
+    MOVED.swap(0, Ordering::Relaxed)
+}
+
+fn block_of(id: u32) -> usize {
+    id as usize / SIB_BLOCK
+}
+
+impl TreeStore {
+    fn block_pages(&self, b: usize) -> std::ops::Range<u32> {
+        (b * SIB_BLOCK) as u32..((b + 1) * SIB_BLOCK).min(self.num_pages) as u32
+    }
+
+    fn alloc_block(&mut self) -> Result<usize, BpannError> {
+        while !self.num_pages.is_multiple_of(SIB_BLOCK) {
+            self.alloc_tagged(0)?;
+        }
+        let b = self.num_pages / SIB_BLOCK;
+        for _ in 0..SIB_BLOCK {
+            self.alloc_tagged(0)?;
+        }
+        Ok(b)
+    }
+
+    fn move_leaf(&mut self, from: u32, to: u32) {
+        let words = self.meta_words(from).to_vec();
+        self.meta_words_mut(to).copy_from_slice(&words[..META_WORDS]);
+        let (src, dst) = (self.code_page_range(from), self.code_page_range(to));
+        self.codes.copy_within(src, dst.start);
+        self.mark_free(from);
+        MOVED.fetch_add(1, Ordering::Relaxed);
+    }
+
+    fn fits_in(&self, b: usize, group: &[u32]) -> bool {
+        let pages = self.block_pages(b);
+        pages.len() == SIB_BLOCK
+            && pages
+                .clone()
+                .all(|p| self.is_free(p) || group.contains(&p))
+    }
+
+    fn pack_into(&mut self, b: usize, group: &mut [u32]) {
+        for g in group.iter_mut() {
+            if block_of(*g) == b {
+                continue;
+            }
+            if let Some(p) = self.block_pages(b).find(|&p| self.is_free(p)) {
+                self.move_leaf(*g, p);
+                *g = p;
+            }
+        }
+    }
+
+    /// Splitting a leaf parent: give each half one aligned block of leaves (report 0244).
+    /// A half with a leaf in a block that holds only that half's leaves (the overflow
+    /// leaf's block) moves there; otherwise the half with fewer leaves in the home block
+    /// moves to a fresh block. Stragglers of the staying half fill the freed home slots.
+    pub(super) fn place_leaf_halves(
+        &mut self,
+        a: &mut Vec<u32>,
+        b: &mut Vec<u32>,
+    ) -> Result<(), BpannError> {
+        let mut hist: Vec<(usize, usize)> = Vec::new();
+        for &k in a.iter().chain(b.iter()) {
+            match hist.iter_mut().find(|e| e.0 == block_of(k)) {
+                Some(e) => e.1 += 1,
+                None => hist.push((block_of(k), 1)),
+            }
+        }
+        let home = hist.iter().max_by_key(|e| e.1).map_or(0, |e| e.0);
+        let spill = |g: &[u32]| {
+            g.iter()
+                .map(|&k| block_of(k))
+                .find(|&blk| blk != home && self.fits_in(blk, g))
+        };
+        let (stay, mover, target) = match (spill(a), spill(b)) {
+            (_, Some(t)) => (a, b, Some(t)),
+            (Some(t), None) => (b, a, Some(t)),
+            (None, None) => {
+                let n_home = |g: &[u32]| g.iter().filter(|&&k| block_of(k) == home).count();
+                if n_home(a) >= n_home(b) {
+                    (a, b, None)
+                } else {
+                    (b, a, None)
+                }
+            }
+        };
+        let target = match target {
+            Some(t) => t,
+            None => self.alloc_block()?,
+        };
+        self.pack_into(target, mover);
+        self.pack_into(home, stay);
+        Ok(())
+    }
+}
