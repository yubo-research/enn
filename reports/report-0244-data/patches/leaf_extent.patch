@@ -0,0 +1,53 @@
+use super::*;
+use crate::index::tree::Tree;
+use crate::index::tree_pbuf::tests::missed_neighbours;
+
+fn row(r: usize, d: usize) -> Vec<f32> {
+    (0..d)
+        .map(|j| ((r * 7919 + j * 104_729) % 1000) as f32 / 1000.0 + (r % 7) as f32)
+        .collect()
+}
+
+fn blocks_per_leaf_parent(t: &Tree) -> Vec<usize> {
+    let s = &t.store;
+    (0..t.num_pages() as u32)
+        .filter(|&p| !s.is_free(p) && !s.is_leaf(p))
+        .filter(|&p| s.ids(p).iter().all(|&c| s.is_leaf(c)))
+        .map(|p| {
+            let mut b: Vec<usize> = s.ids(p).iter().map(|&c| block_of(c)).collect();
+            b.sort_unstable();
+            b.dedup();
+            b.len()
+        })
+        .collect()
+}
+
+#[test]
+fn leaf_parents_keep_their_leaves_in_one_block() {
+    set_leaf_extents(true);
+    let (n, d) = (20_000usize, 6usize);
+    let dir = tempfile::tempdir().unwrap();
+    let mut t = Tree::new_tree(0, &row(0, d), d, dir.path().join("i")).unwrap();
+    for r in 1..n {
+        t.insert_row(r as u32, &row(r, d)).unwrap();
+    }
+    t.pbuf_flush_all().unwrap();
+    assert_eq!(t.leaf_row_ids(), (0..n as u32).collect::<Vec<u32>>());
+    t.assert_counts_consistent();
+    let blocks = blocks_per_leaf_parent(&t);
+    assert!(blocks.len() > 20, "only {} leaf parents", blocks.len());
+    let one = blocks.iter().filter(|&&b| b == 1).count();
+    assert!(
+        one * 10 >= blocks.len() * 9,
+        "{one} of {} leaf parents in one block",
+        blocks.len()
+    );
+    assert!(take_extent_moves() > 0);
+}
+
+#[test]
+fn extent_search_finds_true_neighbours() {
+    set_leaf_extents(true);
+    let missed = missed_neighbours(200);
+    assert!(missed <= 2, "{missed} of 140 true neighbours missed");
+}
