index a1541b6..ca08c7e 100644
--- a/rust/crates/bpann/src/index/tree.rs
+++ b/rust/crates/bpann/src/index/tree.rs
@@ -9,7 +9,21 @@ use crate::index::tree_pbuf_all::pbuf_all;
 use crate::index::tree_resid::RowSrc;
 use crate::index::tree_store::{Kind, TreeStore};

-pub const TREE_LEAF_CAPACITY: usize = 64;
+/// Rows per leaf. Build-time option (report 0254): `ENN_LEAF_CAP=256 maturin build ...`; default 64.
+pub const TREE_LEAF_CAPACITY: usize = parse_cap(option_env!("ENN_LEAF_CAP"), 64);
+
+const fn parse_cap(v: Option<&str>, default: usize) -> usize {
+    let Some(v) = v else { return default };
+    let b = v.as_bytes();
+    let (mut i, mut n) = (0, 0usize);
+    while i < b.len() {
+        assert!(b[i].is_ascii_digit(), "ENN_LEAF_CAP must be a decimal integer");
+        n = n * 10 + (b[i] - b'0') as usize;
+        i += 1;
+    }
+    assert!(n >= 8, "ENN_LEAF_CAP must be >= 8");
+    n
+}
 pub const TREE_FANOUT: usize = 16;
 pub const TREE_CENTROID_STRIDE: u32 = 16;

