+/// Map a row store for random access. Rows are fetched by neighbor index, so without
+/// the hint every cold row fault pulls a full readahead window (128 KiB on the test
+/// disk; report 0235). `ENN_DATA_ADVISE=normal` keeps kernel readahead, for A/B runs.
+pub fn map_random(file: &File) -> std::io::Result<MmapMut> {
+    let m = unsafe { MmapMut::map_mut(file) }?;
+    static RANDOM: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if *RANDOM.get_or_init(|| std::env::var("ENN_DATA_ADVISE").map_or(true, |v| v != "normal")) {
+        let _ = m.advise(memmap2::Advice::Random);
+    }
+    Ok(m)
+}
