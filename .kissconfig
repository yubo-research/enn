# Generated by kiss check
# Thresholds based on max values of analyzed codebase

[global]
min_similarity = 0.9
duplication_enabled = true
orphan_module_enabled = false
comment_removal_enabled = true
docs_allowed = ["./"]
orphan_allowed = []

[test]
test_coverage_threshold = 80
test_coverage_scope = "by_file"
max_num_tests = 1000
num_jobs = 4
watch_settle_seconds = 1.0
pytest_plugins = []
ignore = []

[test.max_unit_test_seconds]
"*" = 10

[python]
statements_per_function = 34
positional_args = 7
keyword_only_args = 6
max_indentation = 4
nested_function_depth = 1
returns_per_function = 6
return_values_per_function = 5
branches_per_function = 8
local_variables = 18
statements_per_try_block = 2
boolean_parameters = 2
decorators_per_function = 1
calls_per_function = 31
methods_per_class = 24
statements_per_file = 204
lines_per_file = 571
functions_per_file = 60
interface_types_per_file = 3
concrete_types_per_file = 4
imported_names_per_file = 48
indirect_dependencies = 93
dependency_depth = 9
cycle_size = 0

[rust]
statements_per_function = 63
arguments = 10
max_indentation = 6
nested_function_depth = 3
returns_per_function = 6
branches_per_function = 11
local_variables = 27
boolean_parameters = 2
attributes_per_function = 3
calls_per_function = 73
methods_per_class = 30
statements_per_file = 189
lines_per_file = 599
functions_per_file = 35
interface_types_per_file = 1
concrete_types_per_file = 6
imported_names_per_file = 23
indirect_dependencies = 0
dependency_depth = 2
cycle_size = 0

