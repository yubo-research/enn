[global]
min_similarity = 0.9
duplication_enabled = true
comment_removal_enabled = true
docs_allowed = []
orphan_allowed = []

[test]
orphan_detection = true
num_jobs = 16
watch_settle_seconds = 1.0
pytest_plugins = []
ignore = []

[test.max_unit_test_seconds]
"*" = 5

[python]
max_num_tests = 1000
num_jobs_pytest = 16
boolean_parameters = 2
branches_per_function = 8
calls_per_function = 26
concrete_types_per_file = 3
cycle_size = 0
decorators_per_function = 2
dependency_depth = 6
functions_per_file = 30
imported_names_per_file = 29
indirect_dependencies = 26
interface_types_per_file = 1
keyword_only_args = 6
lines_per_file = 335
local_variables = 15
max_indentation = 4
methods_per_class = 22
nested_function_depth = 2
positional_args = 7
return_values_per_function = 4
returns_per_function = 5
statements_per_file = 200
statements_per_function = 30
statements_per_try_block = 3

[rust]
max_num_tests = 2000
num_jobs_nextest = 16
arguments = 10
attributes_per_function = 4
boolean_parameters = 2
branches_per_function = 11
calls_per_function = 73
concrete_types_per_file = 6
cycle_size = 0
dependency_depth = 3
functions_per_file = 35
imported_names_per_file = 23
indirect_dependencies = 9
interface_types_per_file = 1
lines_per_file = 589
local_variables = 27
max_indentation = 6
methods_per_class = 30
nested_function_depth = 3
returns_per_function = 6
statements_per_file = 200
statements_per_function = 63

